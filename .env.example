# Local Docker Compose defaults only. Replace every credential in a real deployment.
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://starter:local-development-only@db:5432/starter
POSTGRES_DB=starter
POSTGRES_USER=starter
POSTGRES_PASSWORD=local-development-only
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,api
LOG_LEVEL=INFO
LOG_FORMAT=console
REQUEST_ID_HEADER=X-Request-ID
RATE_LIMIT_ENABLED=true
DEV_MOCK_AUTH=true
VITE_API_BASE_URL=/api
VITE_ENABLE_BROWSER_MOCK=true

