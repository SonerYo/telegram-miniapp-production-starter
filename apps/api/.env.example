APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://starter:local-development-only@localhost:5432/starter
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
LOG_FORMAT=console
REQUEST_ID_HEADER=X-Request-ID
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MUTATIONS_PER_MINUTE=60
DEV_MOCK_AUTH=true

